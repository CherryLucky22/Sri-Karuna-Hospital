# Hospital Management System - Server Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Best Practice: Use a dedicated database user with least privilege
# Set IP Access List in MongoDB Atlas to your server/Vercel static IP or VPC
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
DB_NAME=sri_karuna_hospital_db
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sri_karuna_hospital_db?retryWrites=true&w=majority

# Cryptographically Secure JWT Secret Key (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_base64_string

# Allowed Frontend Origins for CORS (comma-separated for multiple domains)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://yourdomain.com

